# =================================================================
# KisanConnect Environment Configuration
# =================================================================

# Server & Network
PORT=5001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Security: JWT Secret (REQUIRED)
# In production, server will refuse to start if this is unset.
# In development, an ephemeral 32-byte secret is generated if omitted.
JWT_SECRET=your-random-32-byte-secret-here

# Security: Administrator Credentials (REQUIRED)
# No default admin password exists anywhere in code.
# Seeding or initializing the admin account will fail if ADMIN_PASSWORD is missing.
ADMIN_EMAIL=admin@kisanconnect.in
ADMIN_PASSWORD=your-strong-production-admin-password-here

# Demo Mode (default: false)
# When false: demo accounts are not seeded, demo-switch is disabled,
# reset-demo is disabled, and fixed demo OTP (123456) is disabled.
# Set to true ONLY for local development or public hackathon demonstration deployments.
DEMO_MODE=false

# Allowed phone numbers for fixed demo OTP (123456) when DEMO_MODE=true
# Comma-separated list of 10-digit mobile numbers. Real user numbers are never permitted.
DEMO_PHONES=9876543210,9876543211,9876543212,9811122334,9822233445,9833344556,9844455667,9855566778,9866677889,9833322110,9844433221,9999900000
