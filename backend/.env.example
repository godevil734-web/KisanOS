# Backend Environment Configuration
PORT=5001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Required: JWT signing secret (server halts in production if missing)
JWT_SECRET=your-random-32-byte-secret-here

# Required: Admin credentials (no default admin password anywhere in code)
ADMIN_EMAIL=admin@kisanconnect.in
ADMIN_PASSWORD=your-strong-production-admin-password-here

# Demo Mode (default: false)
DEMO_MODE=false

# Allowed phone numbers for fixed demo OTP (123456) when DEMO_MODE=true
DEMO_PHONES=9876543210,9876543211,9876543212,9811122334,9822233445,9833344556,9844455667,9855566778,9866677889,9833322110,9844433221,9999900000
DATABASE_URL=postgresql://user:password@host:port/database
DB_ENV=dev
CRON_SECRET=your-secure-cron-secret-here
# Government Open Data API Key for Real Mandi Prices (data.gov.in)
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
